# --- LLM (agent brain) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Product data source ---
# Free tier (100 searches/month): https://serpapi.com/manage-api-key
# If left blank, the agent automatically falls back to a bundled mock
# product catalog so the whole project still runs end-to-end for a demo.
SERPAPI_API_KEY=your_serpapi_api_key_here